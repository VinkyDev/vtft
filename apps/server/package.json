{
  "name": "server",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "pnpm run build && NODE_ENV=production node dist/index.cjs",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/swagger-ui": "^0.5.2",
    "dotenv": "^17.2.3",
    "hono": "catalog:",
    "lru-cache": "^11.2.2",
    "node-cron": "^4.2.1",
    "logger": "workspace:*",
    "db": "workspace:*",
    "crawler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.7.1",
    "@types/node-cron": "^3.0.11",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "types": "workspace:*"
