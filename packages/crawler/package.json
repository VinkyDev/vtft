{
  "name": "crawler",
  "type": "module",
  "version": "0.0.1",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf ./{*.tsbuildinfo,build,dist,.hash}",
    "build": "rslib build",
    "dev": "rslib build --watch",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "crawl:comps": "node --import tsx/esm src/cli/crawl-comps.ts --save",
    "crawl:items": "node --import tsx/esm src/cli/crawl-items.ts --save",
    "crawl:champions": "node --import tsx/esm src/cli/crawl-champions.ts --save",
    "crawl:augments": "node --import tsx/esm src/cli/crawl-augments.ts --save"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "db": "workspace:*",
    "logger": "workspace:*",
    "playwright": "catalog:",
    "utils": "workspace:*"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@types/node": "catalog:",
    "tsx": "^4.19.2",
    "types": "workspace:*",
    "typescript": "catalog:"
  }
}
